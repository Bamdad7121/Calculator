# GLASS PANEL (frosted container with outer neon glow)
# ==============================================================================
class GlassPanel(QFrame):
    """A rounded, semi-transparent 'glass' container with a soft neon glow."""

    def __init__(self, parent=None, radius: int = 28) -> None:
        super().__init__(parent)
        self._radius = radius
        self.setObjectName("glassPanel")
        self.setStyleSheet(
            f"""
            #glassPanel {{
                background-color: rgba(255, 255, 255, 18);
                border: 1px solid rgba(255, 255, 255, 45);
                border-radius: {radius}px;
            }}
            """
