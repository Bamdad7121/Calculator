        glow.setOffset(0, 0)
        self.setGraphicsEffect(glow)


# ==============================================================================
# NEON BUTTON (glass button with animated glow on hover / press)
# ==============================================================================
class NeonButton(QPushButton):
    """
    A push button styled as frosted glass with a colored neon glow.
    The glow's blur radius animates smoothly on hover and click to give the
    button a premium, tactile feel.
    """

    def __init__(self, text: str, bg: str, hover_bg: str, glow_color: QColor,
                 font_size: int = 22, parent=None) -> None:
        super().__init__(text, parent)
        self._base_blur = 12
        self._hover_blur = 26
        self._press_blur = 42

        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumSize(56, 56)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

        self.setStyleSheet(
            f"""
            QPushButton {{
                background-color: {bg};
                color: {Theme.TEXT_PRIMARY};
                border: 1px solid rgba(255, 255, 255, 35);
                border-radius: 20px;
                font-family: '{Theme.FONT_FAMILY}';
                font-size: {font_size}px;
                font-weight: 600;
            }}
            QPushButton:hover {{
                background-color: {hover_bg};
            }}
            QPushButton:pressed {{
                background-color: {hover_bg};
            }}
            """
        )

        self._glow = QGraphicsDropShadowEffect(self)
        self._glow.setColor(glow_color)
        self._glow.setBlurRadius(self._base_blur)
        self._glow.setOffset(0, 0)
        self.setGraphicsEffect(self._glow)

        self._animation = QPropertyAnimation(self._glow, b"blurRadius", self)
        self._animation.setDuration(160)
        self._animation.setEasingCurve(QEasingCurve.Type.OutCubic)

    def _animate_glow_to(self, target_blur: int) -> None:
        self._animation.stop()
        self._animation.setStartValue(self._glow.blurRadius())
        self._animation.setEndValue(target_blur)
        self._animation.start()

    def enterEvent(self, event) -> None:  # noqa: N802
        self._animate_glow_to(self._hover_blur)
        super().enterEvent(event)

    def leaveEvent(self, event) -> None:  # noqa: N802
        self._animate_glow_to(self._base_blur)
        super().leaveEvent(event)

    def mousePressEvent(self, event) -> None:  # noqa: N802
        self._animate_glow_to(self._press_blur)
        super().mousePressEvent(event)

    def mouseReleaseEvent(self, event) -> None:  # noqa: N802
        target = self._hover_blur if self.underMouse() else self._base_blur
        self._animate_glow_to(target)
        super().mouseReleaseEvent(event)


# ==============================================================================
# DISPLAY PANEL (fixed: no nested QGraphicsEffect -> no ghost/duplicate render)
# ==============================================================================
class DisplayPanel(QFrame):
    """The calculator's screen: shows the live expression and the big result."""

    def __init__(self, parent=None) -> None:
        super().__init__(parent)
        self.setObjectName("displayPanel")
        self.setStyleSheet(
            """
            #displayPanel {
                background-color: rgba(8, 10, 30, 110);
                border: 1px solid rgba(255, 255, 255, 30);
                border-radius: 22px;
            }
            """
        )

        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 18, 24, 18)
        layout.setSpacing(6)

        self.expression_label = QLabel("")
        self.expression_label.setAlignment(
            Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter
        )
        self.expression_label.setStyleSheet(
            f"color: {Theme.TEXT_SECONDARY}; background: transparent; "
            f"font-family: '{Theme.FONT_FAMILY}'; font-size: 16px;"
        )
        self.expression_label.setWordWrap(True)

        self.result_label = QLabel("0")
        self.result_label.setAlignment(
            Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter
        )
        self.result_label.setMinimumHeight(56)
        # NOTE: no QGraphicsOpacityEffect here anymore — nesting a graphics
        # effect inside a widget whose ancestor (GlassPanel) already has its
        # own QGraphicsDropShadowEffect causes Qt to occasionally render the
        # label into a detached/ghost layer at the wrong screen position.
        self._apply_result_style(Theme.TEXT_PRIMARY, 44)

        layout.addWidget(self.expression_label)
        layout.addWidget(self.result_label)

        self._current_font_size = 44
        self._flash_timer = QTimer(self)
        self._flash_timer.setSingleShot(True)
        self._flash_timer.timeout.connect(self._end_flash)

    def _apply_result_style(self, color: str, font_size: int) -> None:
        self.result_label.setStyleSheet(
            f"color: {color}; background: transparent; "
            f"font-family: '{Theme.FONT_FAMILY}'; font-size: {font_size}px; font-weight: 300;"
        )

    def set_expression(self, text: str) -> None:
        self.expression_label.setText(text)

    def set_result(self, text: str, animate: bool = True) -> None:
        self.result_label.setText(text)
        if animate:
            self._start_flash()

    def _start_flash(self) -> None:
        # Lightweight, safe "pulse": briefly swap to the accent color, then
        # back to white. No QGraphicsEffect involved, so nothing detaches
        # from the widget's real geometry.
        self._apply_result_style(Theme.OP_GLOW.name(), self._current_font_size)
        self._flash_timer.start(140)

    def _end_flash(self) -> None:
        self._apply_result_style(Theme.TEXT_PRIMARY, self._current_font_size)

    def shrink_font_if_needed(self, text: str) -> None:
        """Reduce font size for very long results so they always fit."""
        length = len(text)
        if length <= 12:
            size = 44
        elif length <= 18:
            size = 34
        elif length <= 24:
            size = 26
        else:
            size = 20
        self._current_font_size = size
        self._apply_result_style(Theme.TEXT_PRIMARY, size)


