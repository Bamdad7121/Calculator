# ==============================================================================
# CALCULATION ENGINE
# ==============================================================================
class CalculationError(Exception):
    """Raised whenever an expression cannot be safely or correctly evaluated."""


class CalculatorEngine:
    """
    Pure logic layer for the calculator.
    Responsible for sanitizing, safely evaluating expressions, and formatting
    results. Completely decoupled from the UI so it can be unit-tested or
    reused independently.
    """

    _ALLOWED_PATTERN = re.compile(r"^[0-9+\-*/.%() ]*$")
    _PERCENT_PATTERN = re.compile(r"(\d+(\.\d+)?)%")
    _FORBIDDEN_TOKENS = ("__", "import", "lambda", "eval", "exec", "open")

    def __init__(self) -> None:
        self.history: list[tuple[str, str]] = []

    def sanitize(self, expression: str) -> str:
        """Validate characters and convert percentage notation to arithmetic."""
        expression = expression.strip()
        if not expression:
            raise CalculationError("Empty expression")
        if not self._ALLOWED_PATTERN.match(expression):
            raise CalculationError("Invalid characters")
        for token in self._FORBIDDEN_TOKENS:
            if token in expression:
                raise CalculationError("Invalid expression")
        return self._PERCENT_PATTERN.sub(r"(\1/100)", expression)

    def evaluate(self, raw_expression: str) -> str:
        """
        Safely evaluate a math expression typed by the user and return a
        nicely formatted string result. Raises CalculationError on failure.
        """
        clean_expression = self.sanitize(raw_expression)

        try:
            # Restricted eval: no builtins, no names -> only arithmetic reaches here
            result = eval(clean_expression, {"__builtins__": {}}, {})
        except ZeroDivisionError as exc:
            raise CalculationError("Cannot divide by zero") from exc
        except (SyntaxError, TypeError, NameError, ValueError) as exc:
            raise CalculationError("Invalid expression") from exc
        except OverflowError as exc:
            raise CalculationError("Number too large") from exc

        formatted_result = self.format_number(result)
        self.history.append((raw_expression, formatted_result))
        return formatted_result

    @staticmethod
    def format_number(value) -> str:
        """Turn a raw numeric result into a clean, human-friendly string."""
        if isinstance(value, bool):
            return str(value)

        if isinstance(value, float):
            if value.is_integer() and abs(value) < 1e15:
                value = int(value)
            else:
                text = f"{value:.10f}".rstrip("0").rstrip(".")
                return CalculatorEngine._insert_thousand_separators(text)

        return CalculatorEngine._insert_thousand_separators(str(value))

    @staticmethod
    def _insert_thousand_separators(number_text: str) -> str:
        """Add comma thousand separators to the integer part of a number string."""
        negative = number_text.startswith("-")
        if negative:
            number_text = number_text[1:]

        if "." in number_text:
            integer_part, decimal_part = number_text.split(".", 1)
        else:
            integer_part, decimal_part = number_text, ""

        try:
            integer_part = f"{int(integer_part):,}"
        except ValueError:
            pass

        result = integer_part + (f".{decimal_part}" if decimal_part else "")
        return f"-{result}" if negative else result

    def clear_history(self) -> None:
        self.history.clear()


# ==============================================================================
# BACKGROUND WIDGET (gradient + glow orbs)
# ==============================================================================
class NeonBackground(QWidget):
    """Paints the deep navy/purple gradient background with soft glow orbs."""

    def paintEvent(self, event) -> None:  # noqa: N802 (Qt override name)
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        rect = self.rect()

        # Base diagonal gradient
        gradient = QLinearGradient(0, 0, rect.width(), rect.height())
        gradient.setColorAt(0.0, Theme.BG_TOP)
        gradient.setColorAt(1.0, Theme.BG_BOTTOM)
        painter.fillRect(rect, QBrush(gradient))

        # Ambient glow orbs for atmosphere
        self._paint_orb(painter, rect.width() * 0.15, rect.height() * 0.18,
                         rect.width() * 0.45, Theme.ORB_PURPLE)
        self._paint_orb(painter, rect.width() * 0.85, rect.height() * 0.85,
                         rect.width() * 0.5, Theme.ORB_BLUE)
        self._paint_orb(painter, rect.width() * 0.85, rect.height() * 0.1,
                         rect.width() * 0.3, Theme.ORB_PURPLE)

        painter.end()

    @staticmethod
    def _paint_orb(painter: QPainter, cx: float, cy: float, radius: float,
                    color: QColor) -> None:
        radial = QRadialGradient(cx, cy, radius)
        radial.setColorAt(0.0, color)
        transparent = QColor(color)
        transparent.setAlpha(0)
        radial.setColorAt(1.0, transparent)
        painter.setBrush(QBrush(radial))
        painter.setPen(Qt.PenStyle.NoPen)
        painter.drawEllipse(QRectF(cx - radius, cy - radius, radius * 2, radius * 2))


