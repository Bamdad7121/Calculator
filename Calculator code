# ==============================================================================
# MAIN CALCULATOR WINDOW
# ==============================================================================
class NeonCalculatorWindow(QWidget):
    """
    The main application window. Wires together the display, keypad, and
    history panel, and owns all calculator interaction logic.
    """

    OPERATOR_DISPLAY_MAP = {"*": "×", "/": "÷", "-": "−", "+": "+"}

    def __init__(self) -> None:
        super().__init__()
        self.engine = CalculatorEngine()
        self.current_expression = ""
        self.error_state = False

        self.setWindowTitle("Neon Calculator")
        self.setWindowIcon(self._build_app_icon())
        self.resize(760, 560)
        self.setMinimumSize(560, 480)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)

        self._build_ui()
        self._connect_signals()
        self._update_display()

    # ------------------------------------------------------------------ #
    # UI construction
    # ------------------------------------------------------------------ #
    def _build_ui(self) -> None:
        self.background = NeonBackground(self)

        outer_layout = QVBoxLayout(self)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.addWidget(self.background)

        background_layout = QHBoxLayout(self.background)
        background_layout.setContentsMargins(30, 30, 30, 30)
        background_layout.setSpacing(24)

        # ----- Calculator glass panel -----
        calculator_panel = GlassPanel(radius=30)
        calculator_layout = QVBoxLayout(calculator_panel)
        calculator_layout.setContentsMargins(24, 24, 24, 24)
        calculator_layout.setSpacing(18)

        calculator_layout.addLayout(self._build_title_row())

        self.display = DisplayPanel()
        calculator_layout.addWidget(self.display, stretch=0)

        calculator_layout.addLayout(self._build_keypad(), stretch=1)

        # ----- History glass panel -----
        self.history_panel = HistoryPanel()

        background_layout.addWidget(calculator_panel, stretch=3)
        background_layout.addWidget(self.history_panel, stretch=1)

    def _build_title_row(self) -> QHBoxLayout:
        row = QHBoxLayout()

        title = QLabel("NEON CALC")
        title.setStyleSheet(
            f"color: {Theme.TEXT_PRIMARY}; background: transparent; "
            f"font-family: '{Theme.FONT_FAMILY}'; font-size: 16px; "
            f"font-weight: 700; letter-spacing: 4px;"
        )

        self.copy_button = QPushButton("Copy")
        self.copy_button.setCursor(Qt.CursorShape.PointingHandCursor)
        self.copy_button.setFixedHeight(30)
        self.copy_button.setStyleSheet(
            f"""
            QPushButton {{
                background-color: rgba(255, 255, 255, 18);
                color: {Theme.TEXT_PRIMARY};
                border: 1px solid rgba(255, 255, 255, 40);
                border-radius: 15px;
                font-family: '{Theme.FONT_FAMILY}';
                font-size: 12px;
                padding: 0 16px;
            }}
            QPushButton:hover {{
                background-color: rgba(255, 255, 255, 34);
            }}
            """
        )

        row.addWidget(title)
        row.addStretch()
        row.addWidget(self.copy_button)
        return row

    def _build_keypad(self) -> QGridLayout:
        grid = QGridLayout()
        grid.setSpacing(12)

        buttons = [
            # (row, col, rowspan, colspan, text, kind)
            (0, 0, 1, 1, "C", "clear"),
            (0, 1, 1, 1, "%", "operator"),
            (0, 2, 1, 1, "⌫", "operator"),
            (0, 3, 1, 1, "÷", "operator"),
            (1, 0, 1, 1, "7", "number"),
            (1, 1, 1, 1, "8", "number"),
            (1, 2, 1, 1, "9", "number"),
            (1, 3, 1, 1, "×", "operator"),
            (2, 0, 1, 1, "4", "number"),
            (2, 1, 1, 1, "5", "number"),
            (2, 2, 1, 1, "6", "number"),
            (2, 3, 1, 1, "−", "operator"),
            (3, 0, 1, 1, "1", "number"),
            (3, 1, 1, 1, "2", "number"),
            (3, 2, 1, 1, "3", "number"),
            (3, 3, 1, 1, "+", "operator"),
            (4, 0, 1, 2, "0", "number"),
            (4, 2, 1, 1, ".", "number"),
            (4, 3, 1, 1, "=", "equals"),
        ]

        self._button_lookup: dict[str, NeonButton] = {}

        for row, col, rowspan, colspan, text, kind in buttons:
            button = self._create_button(text, kind)
            grid.addWidget(button, row, col, rowspan, colspan)
            self._button_lookup[text] = button

        for col in range(4):
            grid.setColumnStretch(col, 1)
        for row in range(5):
            grid.setRowStretch(row, 1)

        return grid

    def _create_button(self, text: str, kind: str) -> NeonButton:
        style_map = {
            "number": (Theme.NUM_BG, Theme.NUM_HOVER, Theme.NUM_GLOW, 22),
            "operator": (Theme.OP_BG, Theme.OP_HOVER, Theme.OP_GLOW, 22),
            "equals": (Theme.EQ_BG, Theme.EQ_HOVER, Theme.EQ_GLOW, 26),
            "clear": (Theme.CLR_BG, Theme.CLR_HOVER, Theme.CLR_GLOW, 20),
        }
        bg, hover_bg, glow_color, font_size = style_map[kind]
        button = NeonButton(text, bg, hover_bg, glow_color, font_size=font_size)
        button.clicked.connect(lambda _checked, t=text: self._handle_button(t))
        return button

    def _build_app_icon(self) -> QIcon:
        """Programmatically draw a small app icon (no external image files)."""
        size = 128
        pixmap = QPixmap(size, size)
        pixmap.fill(Qt.GlobalColor.transparent)

        painter = QPainter(pixmap)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        path = QPainterPath()
        path.addRoundedRect(QRectF(4, 4, size - 8, size - 8), 28, 28)

        gradient = QLinearGradient(0, 0, size, size)
        gradient.setColorAt(0.0, QColor(56, 130, 246))
        gradient.setColorAt(1.0, QColor(147, 51, 234))
        painter.fillPath(path, QBrush(gradient))

        painter.setPen(QPen(QColor(255, 255, 255, 60), 2))
        painter.drawPath(path)

        painter.setPen(QColor(255, 255, 255))
        font = QFont(Theme.FONT_FAMILY, 54, QFont.Weight.Bold)
        painter.setFont(font)
        painter.drawText(pixmap.rect(), Qt.AlignmentFlag.AlignCenter, "=")

        painter.end()
        return QIcon(pixmap)

    # ------------------------------------------------------------------ #
    # Signal wiring
    # ------------------------------------------------------------------ #
    def _connect_signals(self) -> None:
        self.copy_button.clicked.connect(self._copy_result)
        self.history_panel.clear_button.clicked.connect(self._clear_history)
        self.history_panel.list_widget.itemClicked.connect(self._reuse_history_item)

    # ------------------------------------------------------------------ #
    # Button / keyboard handling
    # ------------------------------------------------------------------ #
    def _handle_button(self, label: str) -> None:
        if label.isdigit():
            self._input_digit(label)
        elif label == ".":
            self._input_decimal()
        elif label == "C":
            self._clear_all()
        elif label == "⌫":
            self._backspace()
        elif label == "%":
            self._input_percent()
        elif label == "=":
            self._evaluate()
        elif label in ("+", "−", "×", "÷"):
            reverse_map = {"+": "+", "−": "-", "×": "*", "÷": "/"}
            self._input_operator(reverse_map[label])

    def keyPressEvent(self, event) -> None:  # noqa: N802
        key = event.key()
        text = event.text()

        if key in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            self._evaluate()
        elif key == Qt.Key.Key_Backspace:
            self._backspace()
        elif key == Qt.Key.Key_Escape:
            self._clear_all()
        elif key == Qt.Key.Key_Percent or text == "%":
            self._input_percent()
        elif text.isdigit():
            self._input_digit(text)
        elif text == ".":
            self._input_decimal()
        elif text in ("+", "-", "*", "/"):
            self._input_operator(text)
        else:
            super().keyPressEvent(event)

    # ------------------------------------------------------------------ #
    # Expression manipulation
    # ------------------------------------------------------------------ #
    def _last_number_segment(self) -> str:
        """Return the numeric segment currently being typed (after the last operator)."""
        match = re.split(r"[+\-*/]", self.current_expression)
        return match[-1] if match else ""

    def _input_digit(self, digit: str) -> None:
        if self.error_state:
            self._clear_all()
        self.current_expression += digit
        self._update_display()

    def _input_decimal(self) -> None:
        if self.error_state:
            self._clear_all()
        segment = self._last_number_segment()
        if "." in segment:
            return  # prevent multiple decimals in the same number
        if segment == "":
            self.current_expression += "0."
        else:
            self.current_expression += "."
        self._update_display()

    def _input_operator(self, operator: str) -> None:
        if self.error_state:
            self._clear_all()
        if not self.current_expression:
            if operator == "-":
                self.current_expression = "-"
                self._update_display()
            return
        if self.current_expression[-1] in "+-*/":
            self.current_expression = self.current_expression[:-1] + operator
        else:
            self.current_expression += operator
        self._update_display()

    def _input_percent(self) -> None:
        if self.error_state or not self.current_expression:
            return
        if self.current_expression[-1] in "+-*/%":
            return
        self.current_expression += "%"
        self._update_display()

    def _backspace(self) -> None:
        if self.error_state:
            self._clear_all()
            return
        self.current_expression = self.current_expression[:-1]
        self._update_display()

    def _clear_all(self) -> None:
        self.current_expression = ""
        self.error_state = False
        self._update_display()

    def _evaluate(self) -> None:
        if not self.current_expression:
            return
        try:
            result = self.engine.evaluate(self.current_expression)
        except CalculationError as error:
            self._show_error(str(error))
            return

        self.error_state = False
        self.display.set_expression(self._format_for_display(self.current_expression) + " =")
        self.display.shrink_font_if_needed(result)
        self.display.set_result(result, animate=True)
        self.history_panel.add_entry(self.current_expression, result)
        self.current_expression = result

    def _show_error(self, message: str) -> None:
        self.error_state = True
        self.display.set_expression(self._format_for_display(self.current_expression))
        self.display.shrink_font_if_needed(message)
        self.display.set_result(message, animate=True)

    # ------------------------------------------------------------------ #
    # Display helpers
    # ------------------------------------------------------------------ #
    def _format_for_display(self, expression: str) -> str:
        formatted = expression
        for raw_op, pretty_op in self.OPERATOR_DISPLAY_MAP.items():
            formatted = formatted.replace(raw_op, pretty_op)
        return formatted

    def _update_display(self) -> None:
        if not self.current_expression:
            self.display.set_expression("")
            self.display.shrink_font_if_needed("0")
            self.display.set_result("0", animate=False)
            return

        display_text = self._format_for_display(self.current_expression)
        self.display.set_expression(display_text)
        self.display.shrink_font_if_needed(display_text)
        self.display.set_result(display_text, animate=False)

    # ------------------------------------------------------------------ #
    # Copy / history actions
    # ------------------------------------------------------------------ #
    def _copy_result(self) -> None:
        QApplication.clipboard().setText(self.display.result_label.text())
        original_text = self.copy_button.text()
        self.copy_button.setText("Copied!")
        QTimer.singleShot(1200, lambda: self.copy_button.setText(original_text))

    def _clear_history(self) -> None:
        self.history_panel.clear()
        self.engine.clear_history()

    def _reuse_history_item(self, item: QListWidgetItem) -> None:
        result = item.data(Qt.ItemDataRole.UserRole)
        if result is not None:
            self.current_expression = str(result)
            self.error_state = False
            self._update_display()


# ==============================================================================
# APPLICATION ENTRY POINT
# ==============================================================================
def _enable_high_dpi_support() -> None:
    """Enable high-DPI scaling attributes where the running Qt version supports them."""
    if hasattr(Qt.ApplicationAttribute, "AA_EnableHighDpiScaling"):
        QApplication.setAttribute(Qt.ApplicationAttribute.AA_EnableHighDpiScaling)
    if hasattr(Qt.ApplicationAttribute, "AA_UseHighDpiPixmaps"):
        QApplication.setAttribute(Qt.ApplicationAttribute.AA_UseHighDpiPixmaps)


def main() -> None:
    _enable_high_dpi_support()

    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    app.setApplicationName("Neon Calculator")

    window = NeonCalculatorWindow()

    # Smooth fade-in animation on startup
    window.setWindowOpacity(0.0)
    window.show()

    fade_in = QPropertyAnimation(window, b"windowOpacity")
    fade_in.setDuration(500)
    fade_in.setStartValue(0.0)
    fade_in.setEndValue(1.0)
    fade_in.setEasingCurve(QEasingCurve.Type.OutCubic)
    fade_in.start()

    # Keep a reference so the animation object is not garbage-collected mid-run
    window._startup_animation = fade_in  # noqa: SLF001

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
